{
  "compilerOptions": {
    "outDir": "./dist/",
    "noImplicitAny": true,
    "module": "commonjs",
    "target": "es6",
    "allowJs": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@util": ["src/util"],
      "@util/*": ["src/util/*"]
    },
    "types": ["handlebars", "webpack-env"],
    "typeRoots": ["node_modules/handlebars"]
  }
}
