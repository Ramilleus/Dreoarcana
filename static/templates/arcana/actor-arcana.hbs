{{!-- Character sheet, Abilities tab: the caster's arcane spells.
      Clicking a spell opens the Arcanum on it; everything else about
      building and casting happens there. --}}
<div class="section arcana-section">
  <div class="basic-table arcane-spells-table">
    <h3 class="table-header-flex">
      <span class="title">Arcane Spells</span>
      <a class="arcanum-open" title="Open the Arcanum: build, cast and vent Heat"><i class="fas fa-hat-wizard"></i> Arcanum</a>
    </h3>
    <table>
      <thead>
        <th class="arcane-sigil-col"></th>
        <th>{{localize 'MYTHRAS.Name'}}</th>
        <th>Tier</th>
        <th>Might</th>
        <th title="Orie the spell needs at your skill">Œ</th>
        <th>Heat</th>
        <th>Cast</th>
        <th class="delete-column"><i class="fas fa-trash"></i></th>
      </thead>
      <tbody>
        {{#each arcana.spells as |s|}}
        <tr class="item" data-item-id="{{s.id}}">
          <td class="arcane-sigil mm-tier-{{s.tier}}"><a class="item-edit" title="Open {{s.name}} in the Arcanum">{{{s.sigil}}}</a></td>
          <td><a class="item-name item-control item-edit">{{s.name}}</a></td>
          <td>{{s.numeral}} {{s.tierName}}</td>
          <td>{{s.might}}</td>
          <td>{{s.orie}}</td>
          <td>{{s.heat}}</td>
          <td title="{{s.rounds}} Rounds">{{s.castTime}}</td>
          <td>
            <a class="item-control item-delete delete-column" title="Delete Item"><i class="fas fa-trash"></i></a>
          </td>
        </tr>
        {{else}}
        <tr><td colspan="8" class="arcane-empty">No arcane spells yet. <a class="arcanum-open">Open the Arcanum</a> to build one.</td></tr>
        {{/each}}
      </tbody>
    </table>
  </div>
  <div class="basic-table arcana-held-table">
    <h3 class="table-header-flex">
      <span class="title">Held Spells, Shields and Barriers</span>
      <a class="arcana-take-damage" title="Damage through Shields and Barriers, then armour and a hit location"><i class="fas fa-heart-crack"></i> Take damage</a>
    </h3>
    {{#if arcana.sustain.any}}
    <table>
      <thead><th>Spell</th><th>Lasts</th><th>ξ</th><th title="Heat each Melee Round while held">Heat/rd</th><th>Shield</th><th>Barrier</th><th class="delete-column"></th></thead>
      <tbody>
        {{#each arcana.sustain.held as |s|}}
        <tr data-effect-uuid="{{s.uuid}}"><td>{{s.name}}{{#if s.target}} <small>on {{s.target}}</small>{{/if}}</td><td>{{s.kind}}</td><td>{{s.xi}}</td><td>{{#if s.held}}{{s.heat}}{{else}}—{{/if}}</td><td>{{#if s.shield}}{{s.shield}}{{else}}—{{/if}}</td><td>{{#if s.barrier}}{{s.barrier}}{{else}}—{{/if}}</td>
          <td>{{#if s.isOwner}}<a class="arcana-let-go delete-column" title="Let it go"><i class="fas fa-times"></i></a>{{/if}}</td></tr>
        {{/each}}
        {{#each arcana.sustain.guarded as |s|}}
        <tr><td>{{s.name}} <small>from {{s.caster}}</small></td><td>{{s.kind}}</td><td>{{s.xi}}</td><td>—</td><td>{{#if s.shield}}{{s.shield}}{{else}}—{{/if}}</td><td>{{#if s.barrier}}{{s.barrier}}{{else}}—{{/if}}</td><td></td></tr>
        {{/each}}
      </tbody>
    </table>
    {{else}}<p class="arcane-empty">Nothing held. A spell set to last in the Arcanum appears here once cast; damage still goes through armour and a hit location.</p>{{/if}}
  </div>
</div>
